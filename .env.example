# Copy this file to .env (same folder) and fill in your DeepSeek API key.
# Without a key set, the app runs in mock mode: every screen works, but
# generation and grading return clearly-labelled placeholder data instead
# of calling out to DeepSeek. That's intentional — it lets you click
# through the whole app before signing up for anything.

DEEPSEEK_API_KEY=

# Rarely need to change these:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model names change over time; current ones are listed at https://api-docs.deepseek.com
# Text model for writing questions and tagging topics (deepseek-v4-pro gives higher quality):
# DEEPSEEK_TEXT_MODEL=deepseek-flash
# Model for grading photographed answer sheets; it must accept images:
# DEEPSEEK_VISION_MODEL=deepseek-flash
# MOCK_MODE=false
